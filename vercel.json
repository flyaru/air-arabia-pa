 "functions":{"api/tts.js":{"maxDuration":30}},
 "git":{"deploymentEnabled":false},
 "headers":[
 {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Permissions-Policy","value":"microphone=(), camera=(), geolocation=()"},{"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; media-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"}]},
 {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-cache"}]},
 {"source":"/api/(.*)","headers":[{"key":"Cache-Control","value":"no-store"}]}
 ]
}
